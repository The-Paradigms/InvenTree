# Caddy reverse proxy configuration for InvenTree
# Handles static & media file delivery, SSL termination, and reverse proxying to InvenTree server

(log_common) {
	log {
		output file /var/log/caddy/{args[0]}.access.log
	}
}

(cors-headers) {
	header Allow GET,HEAD,OPTIONS
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Methods GET,HEAD,OPTIONS
	header Access-Control-Allow-Headers Authorization,Content-Type,User-Agent,traceparent

	@cors_preflight{args[0]} method OPTIONS

	handle @cors_preflight{args[0]} {
		respond "" 204
	}
}

# Internal health check endpoint (port 9090)
:9090 {
	handle /api/system/health/* {
		reverse_proxy {$INVENTREE_SERVER:"http://inventree-server:8000"}
	}

	handle {
		respond 404
	}
}

# Main site endpoint
{$INVENTREE_SITE_URL:"http://, https://"} {
	import log_common inventree

	encode gzip

	request_body {
		max_size 100MB
	}

	# Static files
	handle_path /static/* {
		import cors-headers static
		root * /var/www/static
		file_server
	}

	# Media files (authenticated download)
	handle_path /media/* {
		import cors-headers media
		root * /var/www/media
		file_server

		header Content-Disposition attachment

		forward_auth {$INVENTREE_SERVER:"http://inventree-server:8000"} {
			uri /auth/
		}
	}

	# Proxy all other requests to Gunicorn InvenTree server
	reverse_proxy {$INVENTREE_SERVER:"http://inventree-server:8000"} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
