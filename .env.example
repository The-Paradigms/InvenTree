# =============================================================================
# InvenTree Docker Production Environment Configuration
# =============================================================================
# Copy this file to '.env' before starting the containers:
#   cp .env.example .env
#
# Documentation: https://docs.inventree.org/en/latest/start/config/
# =============================================================================

# Project name used as docker container prefix
COMPOSE_PROJECT_NAME=inventree

# -----------------------------------------------------------------------------
# Image Version & Build Settings
# -----------------------------------------------------------------------------
# Set INVENTREE_TAG to 'stable' (recommended for production) or 'latest'
INVENTREE_TAG=stable
INVENTREE_IMAGE=inventree/inventree

# -----------------------------------------------------------------------------
# Server URL & Networking
# -----------------------------------------------------------------------------
# Specify the URL where InvenTree will be accessed.
# - Local test:       http://localhost
# - Server IP:        http://192.168.1.100  (replace with your machine's IP)
# - Domain with SSL:  https://inventory.example.com  (Caddy auto-provisions HTTPS certificate!)
INVENTREE_SITE_URL="http://localhost"

# Host ports to expose:
INVENTREE_HTTP_PORT=80
INVENTREE_HTTPS_PORT=443

# Internal port used by Gunicorn inside the container (do not change unless necessary)
INVENTREE_WEB_PORT=8000

# Proxy header forwarding
INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True

# -----------------------------------------------------------------------------
# Data Storage & Persistence
# -----------------------------------------------------------------------------
# Path on host machine for persistent storage (Postgres DB, media, static files, configs)
INVENTREE_EXT_VOLUME=./inventree-data

# -----------------------------------------------------------------------------
# Instance Branding & App Settings
# -----------------------------------------------------------------------------
INVENTREE_INSTANCE="TPI Inventory"
INVENTREE_INSTANCE_TITLE=True
INVENTREE_LOG_LEVEL=WARNING
INVENTREE_PLUGINS_ENABLED=True
INVENTREE_AUTO_UPDATE=True
INVENTREE_GUNICORN_TIMEOUT=90

# -----------------------------------------------------------------------------
# Initial Administrator Account (Created automatically on first startup)
# -----------------------------------------------------------------------------
# Change these before first launch, or leave unset to create manually via ./docker-host.sh createsuperuser
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=changeme_admin_password
INVENTREE_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# PostgreSQL Database Settings
# -----------------------------------------------------------------------------
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_NAME=inventree
INVENTREE_DB_USER=pguser
# CHANGE THIS TO A STRONG PASSWORD FOR PRODUCTION!
INVENTREE_DB_PASSWORD=changeme_postgres_password

# -----------------------------------------------------------------------------
# Redis Cache Settings
# -----------------------------------------------------------------------------
INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379
